{
  "name": "meshpay-frontend-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "baseline": "node capture-baseline.mjs baseline",
    "cleanup": "node capture-baseline.mjs cleanup",
    "visual": "node compare.mjs",
    "lint": "eslint ../src/main/resources/static/js . && stylelint \"../src/main/resources/static/css/**/*.css\"",
    "format": "prettier --write ../src/main/resources/static/js ../src/main/resources/static/css *.mjs tests",
    "format:check": "prettier --check ../src/main/resources/static/js ../src/main/resources/static/css *.mjs tests",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "lighthouse": "node lighthouse.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.11.1",
    "acorn": "8.15.0",
    "eslint": "9.39.1",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "globals": "17.4.0",
    "lighthouse": "13.0.3",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "stylelint": "16.25.0"
  }
}
